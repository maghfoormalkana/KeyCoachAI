# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/keycoachai

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for Auth.js)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OmniRoute AI Gateway (configured via Admin UI, defaults below)
OMNIROUTE_BASE_URL=http://192.168.1.7:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_MODEL=gpt-4o-mini

# Admin Settings
ADMIN_SECRET=your-admin-secret-for-protecting-admin-routes
